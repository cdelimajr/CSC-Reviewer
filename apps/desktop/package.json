{
  "name": "cse-reviewer-desktop",
  "productName": "CSE Reviewer",
  "version": "1.0.0",
  "private": true,
  "description": "Windows app for CSE Reviewer. Works offline; syncs with the online CSE Reviewer.",
  "main": "main.js",
  "scripts": {
    "web": "node ../copy-web.js www",
    "start": "npm run web && electron .",
    "dist:win": "npm run web && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ph.csereviewer.desktop",
    "productName": "CSE Reviewer",
    "files": [
      "main.js",
      "www/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "CSE-Reviewer-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CSE Reviewer"
    },
    "portable": {
      "artifactName": "CSE-Reviewer-${version}-portable.exe"
    }
  }
}
